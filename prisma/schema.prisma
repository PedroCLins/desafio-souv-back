datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

model User {
  id       String  @id @default(uuid())
  name     String
  phone    String?
  email    String  @unique
  password String
}

enum ItemType {
  FRUIT
  LEGUME
  DRINK
  MEAT
  BAKERY
}

enum UnitType {
  KG
  LITER
  UNIT
}

model Item {
  id          String   @id @default(uuid())
  name        String
  category    ItemType
  quantity    Int
  unit        UnitType
}